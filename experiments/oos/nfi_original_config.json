{
  "bot_name": "ft-nfi-hist",
  "max_open_trades": 5,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "dry_run": true,
  "dry_run_wallet": 10000,
  "trading_mode": "spot",
  "margin_mode": "",
  "use_exit_signal": true,
  "exit_profit_only": false,
  "ignore_roi_if_entry_signal": true,
  "initial_state": "running",
  "grinding_enable": true,
  "unfilledtimeout": {
    "entry": 3,
    "exit": 2,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": false,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": false,
    "order_book_top": 1
  },
  "exchange": {
    "name": "kucoin",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT",
      "SOL/USDT",
      "XRP/USDT",
      "DOGE/USDT",
      "ADA/USDT",
      "LINK/USDT",
      "LTC/USDT",
      "AVAX/USDT",
      "DOT/USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "internals": {
    "process_throttle_secs": 5
  },
  "dataformat_ohlcv": "feather",
  "dataformat_trades": "feather",
  "config_files": [
    "config-nfi-hist.json"
  ]
}